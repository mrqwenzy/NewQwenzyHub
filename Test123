-- // missions

local function findMission(currentTime)
	local RegionMissions = LocalPlayer.PlayerGui.Data.Missions.RegionMissions

	if currentTime - cache.lastCacheUpdate > cache.cacheInterval then
		cache.regionChildren = RegionMissions:GetChildren()
		cache.shoomChildren = ShoomPiles:GetChildren()

		local am = 0
		for _, v in Players.LocalPlayer.PlayerGui.Data.Unlocks:GetChildren() do
			if v.Value and v.Value > 0 then
				am += 1
			end
		end
		cache.UnlockedStyles = am
		cache.lastCacheUpdate = currentTime
		cache.GachaTokens = LocalPlayer.PlayerGui.Data.Items.FreeSpinToken.Value
		cache.MaxGrowthToken = LocalPlayer.PlayerGui.Data.Items.FullGrowToken.Value
		cache.PartialGrowToken = LocalPlayer.PlayerGui.Data.Items.PartialGrowToken.Value
		cache.ReviveToken = LocalPlayer.PlayerGui.Data.Items.CreatureReviveToken.Value
	end

	if canSniff then
		for i = 1, #cache.regionChildren do
			local _region = cache.regionChildren[i]
			if regions[_region.Name] and _region.Sniff.Amount.Value < _region.Sniff.TargetAmount.Value then
				return "Sniff", _region.Name
			end
		end
	end

	for i = 1, #cache.shoomChildren do
		local v = cache.shoomChildren[i]
		if v:IsA("Model") and v.Name ~= "Nodes" then
			local shoomPart = v:FindFirstChild("Shoom")
			if shoomPart and shoomPart.Transparency == 0 then
				return "ShoomPile", "Any", v
			end
		end
	end

	local slot = getSlot()
	if slot then
		local food, maxfood = getHungerInfo()
		local water, maxwater = getThirstInfo()
		if (maxwater and water and maxwater - water > 5) or (maxfood and food and maxfood - food > 5) then
			for i = 1, #cache.regionChildren do
				local _region = cache.regionChildren[i]
				if regions[_region.Name] then
					local eatFoodMission = _region:FindFirstChild("EatFoodDrinkWater")
					if eatFoodMission and eatFoodMission.Amount.Value < eatFoodMission.TargetAmount.Value then
						return "EatFoodDrinkWater", _region.Name
					end
				end
			end
		else
			if not cache.TailDropped and not busy then
				cache.TailDropped = true
				task.delay(10, function()
					cache.TailDropped = false
				end)
				local Event = ReplicatedStorage.Remotes.ActivateAbility
				Event:FireServer("TailDrop")
			end
		end
	end

	for i = 1, #cache.regionChildren do
		local _region = cache.regionChildren[i]
		if regions[_region.Name] then
			local concealScent = _region:FindFirstChild("ConcealScent")
			if concealScent and concealScent.Amount.Value < concealScent.TargetAmount.Value then
				return "ConcealScent", _region.Name
			end
		end
	end

	for i = 1, #cache.regionChildren do
		local _region = cache.regionChildren[i]
		if
			regions[_region.Name]
			and _region.DistanceTravelled.Amount.Value < _region.DistanceTravelled.TargetAmount.Value
		then
			return "DistanceTravelled", _region.Name
		end
	end

	for i = 1, #cache.regionChildren do
		local _region = cache.regionChildren[i]
		if regions[_region.Name] then
			local attackHeal = _region:FindFirstChild("AttackOrHealCreatureOrNPC")
			if attackHeal and attackHeal.Amount.Value < attackHeal.TargetAmount.Value then
				return "AttackOrHealCreatureOrNPC", _region.Name
			end
		end
	end

	for i = 1, #cache.regionChildren do
		local _region = cache.regionChildren[i]
		if regions[_region.Name] and _region.TimePlayed.Amount.Value < _region.TimePlayed.TargetAmount.Value then
			return "TimePlayed", _region.Name
		end
	end

	return nil, nil
end

-- // execute

local function executeMission(mission, region, shoom, humr)
	if mission == "DistanceTravelled" then
		CONFIG.State = "Orbiting for distance"
		busy = true
		task.delay(1.2, function()
			busy = false
		end)

		teleportToPosition(humr, positionStringToCFrame(regions[region].Position))
		task.wait(0.1)
		local centerPos = positionStringToCFrame(regions[region].Position)
		changeRegionRemote(region)
		task.wait(0.05)
		orbitAround(humr, centerPos, CONFIG.OrbitRadius, CONFIG.OrbitSpeed)
	elseif mission == "Sniff" then
		if currRegion ~= region then
			CONFIG.State = "Sniff - Moving"
			busy = true
			task.delay(0.15, function()
				busy = false
				changeRegionRemote(region)
			end)
			teleportToPosition(humr, positionStringToCFrame(regions[region].Position))
			currRegion = region
		else
			local food, cf = getClosestFood(humr)
			if food then
				CONFIG.State = "Sniff - Eating"
				busy = true
				task.delay(0.6, function()
					busy = false
				end)
				teleportToPosition(humr, cf)
				task.wait(0.3)
				clickButton(Enum.KeyCode.H)
				canSniff = false
				task.delay(10, function()
					canSniff = true
				end)

				if food.Name == "Algae" or food.Name == "Grass" then
					eatFood(food)
				end
				currRegion = nil
			else
				clickButton(Enum.KeyCode.Three)
			end
		end
	elseif mission == "EatFoodDrinkWater" then
		CONFIG.State = "EatFoodDrinkWater"
		if currRegion ~= region then
			CONFIG.State = "EatFoodDrinkWater - Moving"
			busy = true
			task.delay(0.15, function()
				busy = false
				changeRegionRemote(region)
			end)
			teleportToPosition(humr, positionStringToCFrame(regions[region].Position))
			currRegion = region
		else
			local food, cf = getClosestFood(humr)
			if food then
				CONFIG.State = "EatFoodDrinkWater - Eating"
				busy = true
				task.delay(0.5, function()
					busy = false
				end)
				teleportToPosition(humr, cf)
				drinkWater()
				eatFood(food)
				task.wait(0.2)
				humr.Velocity = Vector3.zero
			end
		end
	elseif mission == "ShoomPile" then
		busy = true
		task.delay(0.3, function()
			busy = false
		end)
		CONFIG.State = "Picking up Shoom"
		if shoom then
			teleportToPosition(humr, shoom.WorldPivot)
			task.wait(0.02)
			clickButton(Enum.KeyCode.E)
		end
	elseif mission == "ConcealScent" then
		CONFIG.State = "ConcealScent"
		if currRegion ~= region then
			CONFIG.State = "ConcealScent - Moving"
			busy = true
			task.delay(0.2, function()
				busy = false
				changeRegionRemote(region)
			end)
			teleportToPosition(humr, positionStringToCFrame(regions[region].Position))
			currRegion = region
		else
			local mud, cf = getClosestMud(humr)
			if mud then
				CONFIG.State = "ConcealScent - Hiding"
				busy = true
				task.delay(0.8, function()
					busy = false
				end)
				teleportToPosition(humr, cf)
				task.wait(0.2)
				hideScent(mud)
			end
		end
	elseif mission == "TimePlayed" then
		CONFIG.State = "Surviving in " .. region
		busy = true
		task.delay(0.6, function()
			busy = false
			changeRegionRemote(region)
		end)
		teleportToPosition(humr, positionStringToCFrame(regions[region].Position))
		currRegion = region
	elseif mission == "AttackOrHealCreatureOrNPC" then
		CONFIG.State = "Attacking NPCs"
		if currRegion ~= region then
			CONFIG.State = "Moving to NPCs"
			busy = true
			task.delay(0.2, function()
				busy = false
				changeRegionRemote(region)
			end)
			teleportToPosition(humr, positionStringToCFrame(regions[region].Position))
			currRegion = region
		else
			local roots = workspace.Interactions.NPCs.Roots
			local aliveBums = {}

			for _, bum in ipairs(roots:GetChildren()) do
				if not bum:GetAttribute("Dead") then
					table.insert(aliveBums, bum)
				end
			end

			if #aliveBums > 0 then
				for _, bum in ipairs(aliveBums) do
					CONFIG.State = "Killing " .. bum.Name
					for _ = 1, 2 do
						attackTarget(bum)
						task.wait(0.02)
					end
				end
			end

			currRegion = region
		end
	end
end

-- // start

task.spawn(function()
	setfpscap(CONFIG.FPS)
end)

-- // ui loop

task.spawn(function()
	while active do
		local elapsed = tick() - started
		title.Text = "Farming " .. secondsToTime(elapsed) .. " | State: " .. CONFIG.State

		local shooms = tonumber((ShoomText.Text:gsub(",", "")))
		if shooms then
			local farmed = shooms - startShooms
			local perMinute = elapsed > 0 and math.floor((farmed / elapsed) * 60) or 0
			subtitle.Text = "Shooms | Total: " .. shooms .. " | Farmed: " .. farmed .. " | /min: " .. perMinute
		end

		local deathPoints = tonumber(DPointsText.Text) or 0
		deathPointsLabel.Text = "Death Points: " .. deathPoints .. " / " .. CONFIG.MaxDeathPoints

		maxGrowthLabel.Text = "Max Growth: "
			.. cache.MaxGrowthToken
			.. " | Partial Growth: "
			.. cache.PartialGrowToken
			.. " | Revive: "
			.. cache.ReviveToken

		task.wait(0.15)
	end
end)

-- // bg tasks

task.spawn(function()
	while active do
		if CONFIG.Autofarm and not busy then
			local SaveSelectionGui = LocalPlayer.PlayerGui.SaveSelectionGui
			local DeathGui = LocalPlayer.PlayerGui.DeathGui

			if SaveSelectionGui.Enabled or DeathGui.Enabled then
				Spawn()
			end
		end

		if cache.UnlockedStyles < 10 and tonumber((ShoomText.Text:gsub(",", ""))) > 90 then
			local Event = ReplicatedStorage.Remotes.PurchaseItemRemote
			Event:InvokeServer("Carnivores", 1)
		end

		if cache.GachaTokens > 0 then
			local Event = ReplicatedStorage.Remotes.UseTokenRemote
			Event:InvokeServer("FreeSpinToken")
			cache.GachaTokens -= 1
		end

		if getSlot() then
			if getSlot().Age.Value == 100 then
				local Event = ReplicatedStorage.Remotes.SetElderAgeRemote
				Event:InvokeServer(getSlot().Name, 1)
			elseif getSlot().Age.Value == 200 then
				if BecomeVeneratedUI.Visible then
					local button =
						LocalPlayer.PlayerGui.PromptGui.PromptFrame.PromptFrames.BecomeVenerated.RunButton.UpperLabel
					buttonClickSignal(button)
				end
			end

			if getSlot().Food.Value < 3 then
				local humr = LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
				if humr then
					local food = getClosestFood(humr)
					if food then
						eatFood(food)
					end
				end
			end

			if getSlot().Water.Value < 3 then
				drinkWater()
			end
		end

		task.wait(1.2)
	end
end)

-- // render

local cns = {}
cns.Render = RunService.RenderStepped:Connect(function()
	if getgenv().Ver ~= currver then
		for _, cn in cns do
			cn:Disconnect()
			active = false
		end
		return
	end

	if busy or not CONFIG.Autofarm then
		return
	end

	local char = LocalPlayer.Character
	local humr = char and char:FindFirstChild("HumanoidRootPart")
	if not humr then
		return
	end

	if DPointsText and not cache.DiedRecently then
		if not cache.DietTypeOpen then
			buttonClickSignal(DietType)
			cache.DietTypeOpen = true
			task.delay(1.2, function()
				buttonClickSignal(DietClose)
				task.wait(4)
				cache.DietTypeOpen = false
			end)
		end

		busy = true
		task.wait(0.2)

		local backup = task.delay(6, function()
			busy = false
		end)

		if tonumber(DPointsText.Text) >= CONFIG.MaxDeathPoints then
			task.wait(1.5)
			if tonumber(DPointsText.Text) < CONFIG.MaxDeathPoints then
				task.cancel(backup)
				busy = false
				return
			end
			if cache.lastHit and tick() - cache.lastHit < 12 then
				task.cancel(backup)
				busy = false
				return
			end
			while task.wait(0.3) do
				teleportToPosition(humr, CFrame.new(0, 5000, 0))
				if char and char.Parent and humr and humr.Parent then
					humr.Velocity = Vector3.new(0, 0.3, 0)
				else
					break
				end
			end
			cache.DiedRecently = true
			task.delay(12, function()
				cache.DiedRecently = false
			end)
			busy = false
		else
			task.cancel(backup)
			busy = false
		end
	end

	local mission, region, shoom = findMission(tick())

	if mission and region then
		executeMission(mission, region, shoom, humr)
	else
		CONFIG.State = "Waiting for mission"
	end
end)
