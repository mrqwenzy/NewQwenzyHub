end

local function AddBusy(time)
	CONFIG.Busy += 1

	local cleaned = false
	local thread

	local function Cleanup(fromDelay)
		if cleaned then
			return
		end

		cleaned = true

		if not fromDelay and thread then
			task.cancel(thread)
			thread = nil
		end

		CONFIG.Busy = (CONFIG.Busy or 1) - 1
	end

	thread = task.delay(time or 0.1, function()
		Cleanup(true)
	end)

	return function()
		Cleanup(false)
	end
end

local function getThirstInfo()
	local success, current, max = pcall(function()
		local label =
			LocalPlayer.PlayerGui.CreatureInfoGui.ContainerFrame.TabFrames.MyCreature.StatsFrame.VitalityFrame.Thirst.AmountLabel
		local c, m = label.Text:match("(%d+)%s*/%s*(%d+)")
		return tonumber(c), tonumber(m)
	end)
	return success and current or nil, success and max or nil
end

local function getHungerInfo()
	local success, current, max = pcall(function()
		local label =
			LocalPlayer.PlayerGui.CreatureInfoGui.ContainerFrame.TabFrames.MyCreature.StatsFrame.VitalityFrame.Hunger.AmountLabel
		local c, m = label.Text:match("(%d+)%s*/%s*(%d+)")
		return tonumber(c), tonumber(m)
	end)
	return success and current or nil, success and max or nil
end

local function GetHealthInfo()
	local char = Players.LocalPlayer.Character
	if char then
		local CharData = char:FindFirstChild("Data")
		if CharData then
			local Health, MaxHealth = CharData:GetAttribute("h") or 400, char:GetAttribute("mh") or 400
			return Health, MaxHealth
		end
	end
	return nil, nil
end
