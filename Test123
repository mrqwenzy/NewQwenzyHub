local function getClosestMud(targetPart)
	local mudFolder = workspace.Interactions.Mud
	local targetPos = targetPart.Position

	local closest, closestDist = nil, math.huge
	local finalCF = nil

	for _, mudpile in mudFolder:GetChildren() do
		local cf = mudpile.CFrame
		local dist = (cf.Position - targetPos).Magnitude

		if dist < closestDist then
			closest = mudpile
			closestDist = dist
			finalCF = cf
		end
	end

	return closest, finalCF
end

local function getClosestFood(targetPart)
	local foodFolder = workspace.Interactions.Food
	local targetPos = targetPart.Position

	local closest, closestDist = nil, math.huge
	local finalCF = nil

	for _, food in foodFolder:GetChildren() do
		if food:IsA("Model") and food:GetAttribute("Value") and food:GetAttribute("Value") > 0 then
			if food.Name == "Algae" or food.Name == "Fruit" or food.Name == "Grass" or food.Name == "Berries" then
				local cf = food.PrimaryPart and food.PrimaryPart.CFrame or food:GetPivot()
				local dist = (cf.Position - targetPos).Magnitude

				if dist < closestDist then
					closest = food
					closestDist = dist
					finalCF = cf
				end
			end
		end
	end

	return closest, finalCF
end
local function getAvaliableTarget(canKill)
	for _, Target in workspace.Characters:GetChildren() do
		if Target.Name ~= Players.LocalPlayer.Name then
			local TargetData = Target:FindFirstChild("Data")
			if TargetData then
				local Health = TargetData:GetAttribute("h") or 0
				if Health > 300 or canKill then
					return Target
				else
					warn(Target.Name .. "too low hp: " .. Health)
				end
			end
		end
	end
	return nil
end
