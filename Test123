-- // utils

local function positionStringToCFrame(s)
	local x, y, z = string.match(s, "(-?%d+%.?%d*),%s*(-?%d+%.?%d*),%s*(-?%d+%.?%d*)")
	return CFrame.new(tonumber(x), tonumber(y), tonumber(z))
end

local function teleportToPosition(humanoidRootPart, targetCFrame)
	if CONFIG.UseTeleport then
		humanoidRootPart.CFrame = targetCFrame
		humanoidRootPart.Velocity = Vector3.zero
		if CONFIG.AggressiveMode then
			task.wait(CONFIG.TeleportDelay)
		else
			task.wait(CONFIG.TeleportDelay + 0.01)
		end
	else
		local distance = (targetCFrame.Position - humanoidRootPart.Position).Magnitude
		local tweenTime = distance / CONFIG.TweenSpeed
		local tweenInfo = TweenInfo.new(tweenTime)
		TweenService:Create(humanoidRootPart, tweenInfo, { CFrame = targetCFrame }):Play()
		task.wait(tweenTime + 0.05)
	end
end

local function orbitAround(humanoidRootPart, centerCFrame, radius, duration)
	local steps = CONFIG.OrbitSteps

	for i = 0, steps do
		if not humanoidRootPart.Parent then
			break
		end

		local progress = i / steps
		local angle = progress * math.pi * 2
		local offset = CFrame.new(math.cos(angle) * radius, 0, math.sin(angle) * radius)
		humanoidRootPart.CFrame =
			CFrame.new(centerCFrame.Position + Vector3.new(math.cos(angle) * radius, 0, math.sin(angle) * radius))
		humanoidRootPart.Velocity = Vector3.zero

		task.wait(0.03)
	end
end

local function randomWalkNearby(humanoidRootPart, centerPos, range)
	if not CONFIG.RandomWalk then
		return
	end

	local randX = (math.random() - 0.5) * range
	local randZ = (math.random() - 0.5) * range
	local newPos = centerPos + Vector3.new(randX, 0, randZ)

	teleportToPosition(humanoidRootPart, CFrame.new(newPos))
end

local function secondsToTime(seconds)
	seconds = math.floor(seconds)
	local h = math.floor(seconds / 3600)
	local m = math.floor((seconds % 3600) / 60)
	local s = seconds % 60

	if h > 0 then
		return string.format("%02d:%02d:%02d", h, m, s)
	else
		return string.format("%02d:%02d", m, s)
	end
end

