local function Spawn()
	busy = true
	local backup = task.delay(10, function()
		busy = false
	end)

	if UpdateLogGui.Enabled and UpdateLogGui.ContainerFrame.Visible then
		CONFIG.State = "Closing update log"
		buttonClickSignal(UpdateLogGui.ContainerFrame.UpdateEntry.NotificationsEnabledFrame.ReturnButton.UpperLabel)
		task.wait(0.3)
	end

	local slotNum = getSlot().Name:gsub("Slot", "")
	local AllSlotsFrame = LocalPlayer.PlayerGui.SaveSelectionGui.ContainerFrame.AllSlotsFrame
	local RestartCreatureWithMods = LocalPlayer.PlayerGui.PromptGui.PromptFrame.PromptFrames.RestartCreature
	local RestartCreature = LocalPlayer.PlayerGui.PromptGui.PromptFrame.PromptFrames.RestartCreatureNoMutations
	local slotsInnerFrame = AllSlotsFrame.SlotsFrame[slotNum].InnerFrame
	local slotChangeButton = AllSlotsFrame.PagesFrame:FindFirstChild(slotNum)
	local restartButton = slotsInnerFrame.CreatureFrame.ButtonsFrame.RestartButton.UpperLabel
	local restartButton2NoMods =
		LocalPlayer.PlayerGui.PromptGui.PromptFrame.PromptFrames.RestartCreatureNoMutations.RunButton.UpperLabel
	local restartButton2Mods =
		Players.LocalPlayer.PlayerGui.PromptGui.PromptFrame.PromptFrames.RestartCreature.RunButton.UpperLabel
	local button = slotsInnerFrame.CreatureFrame.ButtonsFrame.PlayButton.UpperLabel
	local DeathGui = LocalPlayer.PlayerGui.DeathGui

	if DeathGui.Enabled and DeathGui.ContainerFrame.Visible then
		CONFIG.State = "Respawning"
		buttonClickSignal(DeathGui.ContainerFrame.BottomFrame.ButtonsFrame.Return.UpperLabel)
		task.wait(1)
	end

	firesignal(slotChangeButton.MouseButton1Click)
	task.wait(0.5)

	if slotsInnerFrame.CreatureFrame.DeadLabel.Visible then
		CONFIG.State = "Spawning"
		buttonClickSignal(restartButton)
		task.wait(0.5)

		if RestartCreature.Visible then
			buttonClickSignal(restartButton2NoMods)
		elseif RestartCreatureWithMods.Visible then
			if RestartCreatureWithMods.KeepMutationsButton.SelectedLabel.Visible then
				task.wait(0.02)
				buttonClickSignal(RestartCreatureWithMods.KeepMutationsButton)
				task.wait(0.5)
			end
			buttonClickSignal(restartButton2Mods)
		end
		task.wait(1.5)
	end

	if AllSlotsFrame.Visible then
		firesignal(button.MouseButton1Click)
		task.cancel(backup)
		task.wait(1.5)
		buttonClickSignal(
			LocalPlayer.PlayerGui.CreatureInfoGui.ContainerFrame.TabButtons.TopFrame.SurvivalStats.UpperLabel
		)
		busy = false
	end
end

