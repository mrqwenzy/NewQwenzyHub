local function goToRegion(region)
	local char = Players.LocalPlayer.Character
	if char then
		local humr = char:FindFirstChild("HumanoidRootPart")
		if humr then
			if regions[region] then
				AddBusy(0.5)
				teleportToPosition(humr, positionStringToCFrame(regions[region].Position))
				cache.CurrentRegion = region
			else
				print("NO region shit")
				cache.CurrentRegion = region
			end
			ChangeRegionRemote(region)
		else
			warn("No root part")
		end
	else
		warn("No character")
	end
end

setfpscap(10)
local function executeMission(mission, region, shoom, humr)
	if mission == "DistanceTravelled" then
		if cache.CurrentRegion ~= region then
			goToRegion(region)
		else
			CONFIG.State = "DistanceTravelled"
			local centerPos = positionStringToCFrame(regions[region].Position)

			cache.Angle = (cache.Angle or 0) + math.rad(15)

			local radius = 150

			teleportToPosition(
				humr,
				centerPos * CFrame.new(math.cos(cache.Angle) * radius, 0, math.sin(cache.Angle) * radius)
			)
			task.wait(0.1)

			ChangeRegionRemote(region)
			task.wait(0.05)
		end
	elseif mission == "Sniff" then
		if cache.CurrentRegion ~= region then
			goToRegion(region)
		else
			local food, cf = getClosestFood(humr)
			if food then
				CONFIG.State = "Sniff"
				AddBusy(2)
				teleportToPosition(humr, cf)
				task.wait(1)
				pressKey(Enum.KeyCode.H)
				cache.CanSniff = false
				task.delay(15.1, function()
					cache.CanSniff = true
				end)

				if food.Name == "Algae" or food.Name == "Grass" then
					eatFood(food)
				end
				cache.CurrentRegion = nil
			else
				pressKey(Enum.KeyCode.Three)
			end
		end
	elseif mission == "EatFoodDrinkWater" then
		CONFIG.State = "EatFoodDrinkWater"
		if cache.CurrentRegion ~= region then
			goToRegion(region)
		else
			local food, cf = getClosestFood(humr)
			if food then
				CONFIG.State = "EatFoodDrinkWater - Eating"
				AddBusy(0.5)
				teleportToPosition(humr, cf)
				drinkWater()
				eatFood(food)
				task.wait(0.2)
				humr.Velocity = Vector3.zero
			end
		end
	elseif mission == "ShoomPile" then
		local region = shoom:GetAttribute("Region")
		print(region)
		print(cache.CurrentRegion)
		if cache.CurrentRegion ~= region then
			goToRegion(region)
			if not regions[region] then
				teleportToPosition(
					humr,
					shoom.WorldPivot * CFrame.new(math.random(-55, 55), math.random(-2, 100), math.random(-55, 55))
				)
				AddBusy(2)
			end
		else
			CONFIG.State = "Picking up Shoom"
			if shoom then
				teleportToPosition(
					humr,
					shoom.WorldPivot * CFrame.new(math.random(-2, 2), math.random(-2, 2), math.random(-2, 2))
				)
				task.wait(0.02)
				pressKey(Enum.KeyCode.E)
			end
		end
	elseif mission == "ConcealScent" then
		CONFIG.State = "ConcealScent"

		if cache.CurrentRegion ~= region then
			goToRegion(region)
		else
			local mud, cf = getClosestMud(humr)
			if mud then
				CONFIG.State = "ConcealScent - Hiding"
				AddBusy(0.4)
				teleportToPosition(humr, cf)
				task.wait(0.2)
				local Event = ReplicatedStorage.Remotes.Mud
				Event:FireServer(mud)
			end
		end
	elseif mission == "TimePlayed" then
		goToRegion(region)
		CONFIG.State = "Surviving in " .. region .. " NOT A BUG"
	elseif mission == "AttackOrHealCreatureOrNPC" then
		CONFIG.State = "Attacking NPCs"
		if cache.CurrentRegion ~= region then
			goToRegion(region)
		else
			local roots = workspace.Interactions.NPCs.Roots
			local aliveBums = {}

			for _, bum in ipairs(roots:GetChildren()) do
				if not bum:GetAttribute("Dead") then
					table.insert(aliveBums, bum)
				end
			end

			if #aliveBums > 0 then
				for _, bum in ipairs(aliveBums) do
					CONFIG.State = "Killing " .. bum.Name
					for _ = 1, 2 do
						attackTarget(bum)
						task.wait(0.02)
					end
				end
			else
				-- local Target = getAvaliableTarget(false)
				-- if Target then
				-- 	local Event = ReplicatedStorage.Remotes.CharactersDamageRemote
				-- 	Event:FireServer({
				-- 		Target,
				-- 	})
				-- 	AddBusy(0.5)
				-- end
			end

			cache.CurrentRegion = region
		end
	end
end
